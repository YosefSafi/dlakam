# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Uu]serSettings/

# Asset meta files must be kept, even if they contain target-platform specific settings.
# !/[Aa]ssets/**/*.meta

# If and only if custom smcs.rsp file is used then uncomment the line below.
# !/[Aa]ssets/smcs.rsp

# Uncomment this line if you wish to ignore the asset database meta files
# /[Aa]ssets/AssetDatabaseV1.meta

# External Native Plugins generated build results
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.IDB
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file, can be regenerated
sysinfo.txt

# Crashlytics generated file
crashlytics-build.properties

# Packed Assets
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa/*

# Nested projects
Dlakam/[Ll]ibrary/
Dlakam/[Tt]emp/
Dlakam/[Ll]ogs/
Dlakam/[Uu]serSettings/
Dlakam/*.csproj
Dlakam/*.sln
Dlakam/*.userprefs
Dlakam/*.user
Dlakam/*.suo
Dlakam/obj/
Dlakam/Build/
Dlakam/Builds/
